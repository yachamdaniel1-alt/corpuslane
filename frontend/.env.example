# Copy to .env.local and fill in values.
# These are inlined by Next.js at build/runtime (NEXT_PUBLIC_*).

# Read-only API + indexer backend (see backend/.env for the backend itself).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Address of the deployed Corpuslane contract (C…). Required for all
# on-chain actions — leave empty to run the UI without a deployed contract.
NEXT_PUBLIC_CONTRACT_ID=

# Soroban RPC endpoint and network passphrase you intend to sign against.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015