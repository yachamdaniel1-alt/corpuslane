# Corpuslane backend configuration
# Copy to .env and adjust before running.

# PostgreSQL connection (used by Prisma + the API/indexer).
DATABASE_URL="postgresql://corpuslane:corpuslane@localhost:5432/corpuslane?schema=public"

# Stellar network the contract was deployed to.
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org:443"
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Address of the deployed Corpuslane contract (C...). Required for the
# indexer to filter events; without it the indexer matches nothing.
CONTRACT_ID=""

# Indexer polling interval in milliseconds.
INDEXER_POLL_INTERVAL_MS=5000

# HTTP API.
PORT=3001

# pino log level: info | debug.
LOG_LEVEL=info